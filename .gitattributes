# 统一行尾,避免 Windows 上core.autocrlf 把整个工程标成改动
# Godot 工程与 GDScript 一律 LF
* text=auto eol=lf

*.gd    text eol=lf
*.uid   text eol=lf
*.tscn  text eol=lf
*.godot text eol=lf
*.cfg   text eol=lf
*.md    text eol=lf
*.svg   text eol=lf
*.import text eol=lf

# PowerShell 脚本:Windows PowerShell 5.1 会按 GBK 解码无 BOM 的 UTF-8,
# 导致中文注释把脚本解析崩掉 —— 编辑 tools/*.ps1 后务必保留 UTF-8 BOM。
*.ps1 text eol=crlf

# 二进制:不做行尾与diff 处理
*.exe binary
*.pck binary
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
