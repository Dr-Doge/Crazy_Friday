[node name="New_Level" type="Node3D" unique_id=259587616]
editor_description = "按v6施工图和当前用户手工排版维护的可编辑CSG白盒。四角外墙以西南角为镜像模板；货架统一深灰，分类色只保留在地板；四组双收银车道均纵向朝向对应出口。"
script = ExtResource("1_main")
embedded_level = true
metadata/layout_version = "new_level_v6_user_waiting_room_v4"
metadata/store_size_m = Vector2(80, 64)
metadata/min_clear_aisle_m = 4.0
metadata/main_aisle_m = 6.0
metadata/reference = "images/黑五扫货_超市施工指示图_v6_2K.png"
metadata/annotation_reference = "images/黑五扫货_超市部件标注图_v7_2K.png"

